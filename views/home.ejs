<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head.ejs") %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomePage</title>
</head>
<body>
    
    <%- include("./partials/Nav.ejs") %>

    <% if (locals.blogs) { %>   
        <div class="row row-cols-1 row-cols-md-3 g-4 mt-4" style="width: 50rem;">
            <% blogs.forEach(blog => { %>
                <div class="col">
                    <div class="card h-100">
                        <img src="/blog_images/<%= blog.image_url%>" class="card-img-top" alt="..." style="height: 50%; object-fit: cover;" name="image"> 
                        <div class="card-body">
                            <h5 class="card-title" name="title"><%= blog.title %></h5>
                        </div> 
                        <div class="card-footer bg-transparent">
                            <a href="/blog/<%= blog._id %>" class="btn btn-primary card-img-bottom">View</a>
                        </div> 
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>

    <%- include("./partials/script.ejs") %>
    
</body>
</html>