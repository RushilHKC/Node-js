<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head.ejs") %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomePage</title>
</head>
<body>
    
    <%- include("./partials/Nav.ejs") %>

    <% if (locals.blogs) { %>   
        <div class="row row-cols-1 row-cols-md-3 g-4 mt-4" style="width: 50rem;">
            <% blogs.forEach(blog => { %>
                <div class="col">
                    <div class="card h-100">
                        <img src="/blog_images/<%= blog.image_url%>" class="card-img-top" alt="...">
                        <div class="card-body">
                            <h5 class="card-title"><%= blog.title %></h5>
                            <!-- <p class="card-text"><%= blog.content %></p> -->
                        </div>  
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>

    <%- include("./partials/script.ejs") %>
    
</body>
</html>